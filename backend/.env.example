# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgres://billing:secret@localhost:5432/billing
PORT=8080
BASE_URL=https://vibelink.tech

# Local development only. tenantByHost() resolves the tenant from the request
# hostname, which never matches on localhost; this pins one. Leave unset in production.
DEV_TENANT=vibelink

# Per-tenant credentials live in the tenant_payment_config table.
# These are only the platform-owner defaults used for SaaS billing.
DARAJA_ENV=production
PLATFORM_SHORTCODE=4098221
PLATFORM_CONSUMER_KEY=
PLATFORM_CONSUMER_SECRET=
PLATFORM_PASSKEY=

AT_USERNAME=zurinet
AT_API_KEY=
AT_SENDER_ID=ZURINET

RADIUS_SECRET=testing123
RADIUS_COA_PORT=3799

# Daraja does not sign its own callbacks, so this secret (appended as ?k=
# to CallBackURL/ConfirmationURL/ValidationURL) is what stops a stranger
# from POSTing a forged "payment succeeded" straight to the webhook. Set
# to a long random value (e.g. `openssl rand -base64 32`) and never leave
# unset in production — the webhook rejects every request until it's set.
DARAJA_WEBHOOK_SECRET=
# Same idea for KopoKopo's X-KopoKopo-Signature HMAC; unset = webhook rejects everything.
KOPOKOPO_WEBHOOK_SECRET=

# Nightly database backup (backend/src/backup.js), pushed off-server to
# Cloudflare R2. Create the API token under R2 → Manage R2 API Tokens
# (Object Read & Write, scoped to R2_BUCKET). Unset = the backup job logs a
# warning and skips instead of failing the whole job process.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vibelink-db-backups
