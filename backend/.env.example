# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgres://billing:secret@localhost:5432/billing
PORT=8080
BASE_URL=https://billing.co.ke

# Local development only. tenantByHost() resolves the tenant from the request
# hostname, which never matches on localhost; this pins one. Leave unset in production.
DEV_TENANT=vibelink

# Per-tenant credentials live in the tenant_payment_config table.
# These are only the platform-owner defaults used for SaaS billing.
DARAJA_ENV=production
PLATFORM_SHORTCODE=4098221
PLATFORM_CONSUMER_KEY=
PLATFORM_CONSUMER_SECRET=
PLATFORM_PASSKEY=

AT_USERNAME=zurinet
AT_API_KEY=
AT_SENDER_ID=ZURINET

RADIUS_SECRET=testing123
RADIUS_COA_PORT=3799
