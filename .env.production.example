# Copy to .env on the VPS and fill in. Never commit the filled copy.
#
#   cp .env.production.example .env
#
# docker-compose.prod.yml reads this file for ${...} substitution.

# ── the domain everything hangs off ───────────────
# Tenants are subdomains of it: acme.vibelink.tech resolves to the tenant whose
# subdomain is "acme". Caddy issues a certificate per hostname on demand.
ROOT_DOMAIN=vibelink.tech

# Let's Encrypt sends expiry warnings here. A real mailbox you read.
ACME_EMAIL=you@example.com

TZ=Africa/Nairobi

# ── database ──────────────────────────────────────
# Generate, do not invent:  openssl rand -base64 24
POSTGRES_USER=billing
POSTGRES_PASSWORD=
POSTGRES_DB=billing

# ── encryption at rest ────────────────────────────
# Encrypts credentials the app must be able to use later and so cannot hash —
# today, the per-router service account passwords. Keep it out of the database:
# that separation is the whole point. Changing it makes existing values
# unreadable, and each router then needs configuring again.
#   openssl rand -base64 32
APP_SECRET_KEY=

# ── RADIUS ────────────────────────────────────────
# Where routers listen for Change-of-Authorization. 3799 is the standard.
RADIUS_COA_PORT=3799

# ── payment webhooks ──────────────────────────────
# Neither Daraja nor KopoKopo's webhook is trustworthy without one of these:
# unset means the API rejects every incoming webhook rather than accepting
# unsigned ones. Generate, do not invent, and never reuse between them:
#   openssl rand -base64 32
DARAJA_WEBHOOK_SECRET=
KOPOKOPO_WEBHOOK_SECRET=

# Optional second layer for /radius/post-auth, independent of Caddy never
# proxying /radius/* from outside. If set, FreeRADIUS's post-auth call must
# send it back as the X-Internal-Secret header or the request is rejected.
# Leave unset to keep today's behavior (Caddy's routing is the only gate).
RADIUS_INTERNAL_SECRET=
