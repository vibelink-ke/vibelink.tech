# TLS and routing for every tenant hostname.
#
# Tenants are subdomains — tenantByHost() takes the first label — so the set of
# names needing a certificate is not known at deploy time and grows with every
# signup. Rather than a wildcard certificate (which would need DNS-01 and a
# custom Caddy build with a DNS plugin), certificates are issued on demand and
# gated by the API.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		# Caddy asks before issuing. The API answers 200 only for a hostname that
		# is a real tenant inside our own zone. Without this, anyone could point a
		# DNS name here and burn the Let's Encrypt rate limit for the domain.
		# Newer Caddy dropped the interval/burst rate limit here and relies on
		# `ask` alone, so that endpoint is the only thing standing between a
		# stranger's DNS record and our Let's Encrypt quota. Keep it strict.
		ask http://net:8080/internal/tls-check
	}
}

# The apex plus every tenant subdomain.
*.{$ROOT_DOMAIN}, {$ROOT_DOMAIN} {
	tls {
		on_demand
	}

	encode gzip zstd

	# Everything the backend owns. /internal is deliberately absent: the TLS gate
	# must not be reachable from outside.
	#
	# The upstream is "net", not "api", and that is not a mistake: the API shares
	# the `net` container's network namespace so it can reach routers over the
	# tunnel, which leaves it without a DNS name of its own.
	handle /api/* {
		reverse_proxy net:8080
	}
	handle /portal/* {
		reverse_proxy net:8080
	}
	handle /webhooks/* {
		reverse_proxy net:8080
	}

	# /radius/* is deliberately not proxied. FreeRADIUS reaches the API over the
	# compose network, so exposing it here would only let strangers POST to
	# /radius/post-auth and start voucher clocks.

	# The React bundle. try_files sends unknown paths to index.html so client-side
	# routes survive a refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
