# TLS and routing for every tenant hostname.
#
# Tenants are subdomains — tenantByHost() takes the first label — so the set of
# names needing a certificate is not known at deploy time and grows with every
# signup. Rather than a wildcard certificate (which would need DNS-01 and a
# custom Caddy build with a DNS plugin), certificates are issued on demand and
# gated by the API.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		# Caddy asks before issuing. The API answers 200 only for a hostname that
		# is a real tenant inside our own zone. Without this, anyone could point a
		# DNS name here and burn the Let's Encrypt rate limit for the domain.
		# Newer Caddy dropped the interval/burst rate limit here and relies on
		# `ask` alone, so that endpoint is the only thing standing between a
		# stranger's DNS record and our Let's Encrypt quota. Keep it strict.
		ask http://net:8080/internal/tls-check
	}
}

# The apex plus every tenant subdomain.
*.{$ROOT_DOMAIN}, {$ROOT_DOMAIN} {
	tls {
		on_demand
	}

	encode gzip zstd

	# Everything the backend owns. /internal is deliberately absent: the TLS gate
	# must not be reachable from outside.
	#
	# The upstream is "net", not "api", and that is not a mistake: the API shares
	# the `net` container's network namespace so it can reach routers over the
	# tunnel, which leaves it without a DNS name of its own.
	handle /api/* {
		reverse_proxy net:8080
	}
	handle /portal/* {
		reverse_proxy net:8080
	}
	handle /webhooks/* {
		reverse_proxy net:8080
	}
	# The captive-portal support widget (hotspot-portal.js's chat, and the
	# customer portal's own copy of it). No admin screen lives under /chat,
	# so unlike /hotspot below this can be the whole prefix — nothing to
	# disambiguate from. Same missing-proxy-rule bug as /hotspot/devices:
	# these routes existed and worked in dev-stack, and 404'd through to
	# index.html here because nothing sent them to the API at all.
	handle /chat/* {
		reverse_proxy net:8080
	}
	# The captive-portal endpoints only — named one by one, not /hotspot/*.
	#
	# The API renders the login page per tenant, and without a proxy rule it fell
	# through to the React bundle: /hotspot/login.html returned 715 bytes of
	# index.html, the router installed that as its login page, and guests got a
	# blank screen.
	#
	# But /hotspot/* is also where the admin UI keeps its own screens, so
	# proxying the whole prefix sent /hotspot/vouchers to Express, which answered
	# "Cannot GET". Only these paths belong to the API; everything else under
	# /hotspot is a page in the app.
	#
	# The list has to be kept in sync with every app.get/app.post('/hotspot/...')
	# in server.js by hand — there is no wildcard-minus-admin-routes rule in
	# Caddy's matcher syntax. It drifted once already (this comment's own
	# history) and drifted again silently as devices/connected/voucher-status/
	# voucher-for-mac/nearby-devices were added later without ever being added
	# here: each of those routes existed, worked in dev-stack, and 200'd from
	# curl — and fell straight through to index.html in production, which
	# looks exactly like the button that calls it doing nothing at all,
	# because that is precisely what a guest clicking it sees.
	@captive path /hotspot/login /hotspot/login.html /hotspot/buy /hotspot/buy/* /hotspot/devices /hotspot/connected /hotspot/voucher-status /hotspot/voucher-for-mac /hotspot/nearby-devices /hotspot/nearby-devices/bind /hotspot/tv-options /hotspot/tv-buy
	handle @captive {
		reverse_proxy net:8080
	}

	# /radius/* is deliberately not proxied. FreeRADIUS reaches the API over the
	# compose network, so exposing it here would only let strangers POST to
	# /radius/post-auth and start voucher clocks.

	# The React bundle. try_files sends unknown paths to index.html so client-side
	# routes survive a refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
