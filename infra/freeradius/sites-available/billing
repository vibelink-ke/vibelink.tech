# Minimal PPPoE / hotspot virtual server for the billing system.
#
# Deliberately small: it authenticates against radcheck, replies with the
# attributes in radreply (Mikrotik-Rate-Limit, Session-Timeout, Expiration) and
# writes accounting into radacct. Everything else FreeRADIUS ships with is
# switched off so there is less to reason about.

#
# Routers are looked up in SQL the first time they appear, rather than read into
# memory at startup. read_clients did the latter, which meant a router onboarded
# after this process began was unknown to it — and FreeRADIUS drops packets from
# an unknown client silently, with nothing in its own log. From the router that
# is indistinguishable from the server being switched off, and the only cure was
# restarting RADIUS after every single onboarding.

server billing {
    listen {
        type = auth
        ipaddr = *
        port = 1812
        clients = tunnel_clients
    }
    listen {
        type = acct
        ipaddr = *
        port = 1813
        clients = tunnel_clients
    }

    authorize {
        preprocess

        # Vouchers and PPPoE users both live in radcheck; the Expiration
        # attribute is what makes a voucher stop working on its own.
        sql

        # No match in SQL means no account — reject rather than fall through to
        # any default that might let someone on.
        #
        # This has to sit immediately after `sql` and test `notfound`. A bare
        # rcode in an unlang condition refers to the *previous module*, so the
        # obvious-looking `if (!ok && !updated)` placed after expiration and
        # logintime actually tested those instead — they return noop for a user
        # with no expiry set, which rejected every login including correct ones.
        if (notfound) {
            reject
        }

        #
        # PPPoE anti-sharing MAC lock — deliberately NOT a radcheck
        # Calling-Station-Id check-item (op '=='), which is how this used to be
        # done. rlm_sql's own check-item comparison rejects the WHOLE authorize()
        # result on any mismatch, discarding everything else it loaded in that
        # same call — including Cleartext-Password — before mschap/pap ever ran.
        # A stale or legitimately-changed MAC didn't just fail its own check, it
        # broke authentication outright regardless of protocol: real customers on
        # real hardware (Mikrotik, ONTs, Tenda routers alike) hit "No NT-Password.
        # Cannot perform authentication" on every reconnect once their line was
        # locked, and clearing the lock was the only thing that ever fixed it —
        # not because the MAC itself mattered, but because clearing it removed
        # the poisoned check-item.
        #
        # subscribers.locked_mac is the same source of truth the app already
        # maintains (lockNewPppoeMacs, clear-mac-lock); querying it directly here
        # keeps the comparison isolated from everything else authorize() loads.
        #
        # %{User-Name}, not %{SQL-User-Name} — confirmed live via raddebug:
        # SQL-User-Name traced as "set to '15864'" immediately before this
        # exact query ran, and the query FreeRADIUS actually executed was
        # still `WHERE pppoe_user=''`, empty. SQL-User-Name is populated by
        # rlm_sql's own top-level module call (the earlier `sql` step just
        # above, which is what set it correctly for ITS OWN radcheck/radreply
        # queries) — referencing it from a second, independent %{sql: ...}
        # xlat like this one doesn't reliably see that value. This is why
        # Tmp-String-0 was always empty, on every request, correct MAC or
        # not: not a comparison bug (both rewrites of the if() below changed
        # nothing because there was never a real value to compare), the
        # lookup itself silently returned nothing every single time. Safe to
        # use the un-escaped attribute here specifically because `notfound`
        # above already rejected anything that isn't an exact match for a
        # real radcheck.Username — by this point User-Name cannot contain
        # anything an attacker chose that isn't already a legitimate,
        # provisioned pppoe_user.
        #
        # locked_mac is Postgres's native `macaddr` type (schema.sql), which
        # always normalizes to lowercase on output regardless of the case it
        # was stored in — confirmed live: this query came back
        # "08:55:31:5f:a9:76" for a device MikroTik itself reports (and
        # Calling-Station-Id carries) as "08:55:31:5F:A9:76". Comparing those
        # two directly rejected the CORRECT device too, the moment the lookup
        # above actually started working — lowercasing Calling-Station-Id
        # into its own scratch var here, rather than the DB value, since the
        # macaddr type's own normalization isn't something to fight.
        update control {
            &Tmp-String-0 := "%{sql: SELECT locked_mac FROM subscribers WHERE pppoe_user='%{User-Name}'}"
            &Tmp-String-2 := "%{tolower:%{Calling-Station-Id}}"
        }
        # Bare attribute comparisons, not quoted/xlat'd strings — proven to
        # work in this FreeRADIUS version by dynamic_client_lookup's own
        # secret check further down this file.
        if (&control:Tmp-String-0 && &control:Tmp-String-0 != "" && &control:Tmp-String-0 != &control:Tmp-String-2) {
            reject
        }

        expiration
        logintime

        # One module per protocol the PPPoE server offers.
        #
        # These do not authenticate here — they inspect the request and set
        # Auth-Type so the authenticate section below knows which to use. Only
        # `pap` was listed, so a CHAP or MS-CHAP login reached authenticate with
        # no Auth-Type and was rejected however correct the password was. Windows
        # uses MS-CHAPv2 by default, so no Windows client could ever have got on.
        chap
        mschap
        pap
    }

    authenticate {
        pap
        chap
        mschap
    }

    preacct {
        preprocess
        acct_unique
        suffix
    }

    accounting {
        # radacct rows drive fair-use usage via the sync trigger in schema.sql.
        sql
        exec
        attr_filter.accounting_response
    }

    session {
        sql
    }

    post-auth {
        sql

        # Tell the app a voucher has been used, so voucher_expiry='login' can
        # start its clock. Fire-and-forget; a failure here must not block auth.
        #
        # This used to just set a control attribute (Tmp-String-0) that went
        # nowhere at all — described as "tell the app," doing none of it. No
        # request of any kind ever reached the api container; every
        # 'login'-mode voucher (hotspot_settings' own default) had its clock
        # never start via this path, full stop. post-auth-hook.sh does the
        # actual telling: an exec'd shell call to POST /radius/post-auth,
        # backgrounded there so a slow api never delays this response.
        #
        # /bin/sh explicitly, matching how entrypoint.sh is invoked for this
        # same compose service — the script's own executable bit is not
        # something a read-only bind mount from a host checkout can be
        # trusted to carry.
        update control {
            &Tmp-String-0 := "%{exec:/bin/sh /config/post-auth-hook.sh %{User-Name}}"
        }

        Post-Auth-Type REJECT {
            sql
            attr_filter.access_reject
        }
    }
}

#
# The pool the listeners above point at. Nothing is listed here: any address in
# the tunnel supernet is allowed to *ask*, and `dynamic_clients` names the
# virtual server that decides whether it is really one of ours.
#
clients tunnel_clients {
    client tunnel {
        ipaddr  = 10.50.0.0
        netmask = 16
        dynamic_clients = dynamic_client_lookup
        # Re-checked periodically, so a router whose secret was rotated or whose
        # row was deleted stops working on its own.
        lifetime = 300
    }
}

#
# Asked once per unknown router. Fills in the three attributes FreeRADIUS needs
# to admit a client, straight from the `nas` view over the routers table.
#
# The secret is the gate: a source address with no row returns an empty string,
# and the reject below keeps it out. Without that check every address in the
# supernet would be admitted with a blank secret.
#
server dynamic_client_lookup {
    authorize {
        #
        # ORDER BY matters more than it looks. These are two separate queries,
        # and LIMIT 1 without an order is not deterministic — so if two rows ever
        # shared an address, the shortname could come from one and the secret
        # from the other. The router then signs with a secret we never compare
        # against, and FreeRADIUS reports "invalid Message-Authenticator" for
        # ever, however many times the configuration is pushed.
        #
        # Ordering both by id makes them agree on a single row. The unique index
        # in schema.sql stops the duplicate arising at all; this keeps the lookup
        # honest regardless.
        update control {
            &FreeRADIUS-Client-IP-Address = "%{Packet-Src-IP-Address}"
            &FreeRADIUS-Client-Shortname  = "%{sql:SELECT shortname FROM nas WHERE nasname = '%{Packet-Src-IP-Address}' ORDER BY id LIMIT 1}"
            &FreeRADIUS-Client-Secret     = "%{sql:SELECT secret FROM nas WHERE nasname = '%{Packet-Src-IP-Address}' ORDER BY id LIMIT 1}"
        }

        if (!&control:FreeRADIUS-Client-Secret || &control:FreeRADIUS-Client-Secret == "") {
            reject
        }
        else {
            ok
        }
    }
}
