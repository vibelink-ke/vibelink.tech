# FreeRADIUS -> the same Postgres the billing app uses.
#
# This is what makes the app's writes take effect: activateSubscriber() inserts
# into radcheck/radreply, and this module reads those rows on the next auth.
sql {
    dialect = "postgresql"
    driver  = "rlm_sql_${dialect}"

    server   = "$ENV{PGHOST}"
    port     = "$ENV{PGPORT}"
    login    = "$ENV{PGUSER}"
    password = "$ENV{PGPASSWORD}"
    radius_db = "$ENV{PGDATABASE}"

    # Standard table names — they match schema.sql.
    acct_table1   = "radacct"
    acct_table2   = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    # queries.conf interpolates this, so leaving it out is a parse error rather
    # than a default.
    group_attribute = "SQL-Group"

    # Off deliberately. This loads the NAS list once, at startup, so a router
    # onboarded afterwards was unknown until someone restarted RADIUS — and an
    # unknown client is dropped silently, which from the router looks exactly
    # like the server being down.
    #
    # The listeners use a dynamic client pool instead (see sites-available/billing),
    # which looks each router up in this same `nas` view the first time it
    # appears. One mechanism, and no restart.
    read_clients = no
    client_table = "nas"

    # Do not let a SQL outage reject everyone; fail through to the next module.
    safe_characters = "@abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_: /"

    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf


    pool {
        # Ten was far too few: every login and every accounting update holds one of these while it writes to the database, and under
        # load requests queued, ran out ("Cannot open new connection, already at max") and were REJECTED, even with a correct code.
        # Postgres allows 100 connections and the API uses up to 20, so 48 here leaves room.
        start    = 8
        min      = 8
        max      = 48
        spare    = 8
        uses     = 0
        lifetime = 0
        idle_timeout = 60
        retry_delay  = 5
    }
}
